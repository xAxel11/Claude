# Copy this file to ".env" and fill in your values:  cp .env.example .env
# .env is git-ignored so your keys never end up on GitHub.

# --- Required -------------------------------------------------------------
# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=paste-your-gemini-key-here

# --- Optional -------------------------------------------------------------
# "auto" = pick the best free model and switch automatically when one is busy/retired.
# Or name a model to try first, e.g. gemini-3-flash-preview
GEMINI_MODEL=auto
# Seconds to wait for a model before switching to another
GEMINI_TIMEOUT=40
# If a model is silent this long, also ask a backup model; fastest answer wins
GEMINI_HEDGE_SECONDS=8

# Free Microsoft neural voice (edge-tts). Jarvis-like options:
#   en-GB-RyanNeural (British male, default), en-GB-ThomasNeural, en-US-GuyNeural
JARVIS_VOICE=en-GB-RyanNeural
JARVIS_VOICE_RATE=+5%
JARVIS_VOICE_PITCH=-2Hz

# How Jarvis addresses you, and speech-recognition language
USER_TITLE=sir
LANGUAGE=en-US
WAKE_WORD=jarvis
# Microphone / camera device indexes (leave blank / 0 for default)
MIC_INDEX=
CAMERA_INDEX=0

# Ask before running shell commands, sending email, posting to Instagram
CONFIRM_ACTIONS=true
START_FULLSCREEN=true

# Email (Gmail: create an App Password at https://myaccount.google.com/apppasswords)
EMAIL_ADDRESS=
EMAIL_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
IMAP_HOST=imap.gmail.com

# Instagram (unofficial API — use at your own risk, see README)
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=
