#!/bin/sh
set -e
if [ "$1" = configure ]; then
    # Use the Horizon wallpaper on the login screen.
    conf=/usr/share/sddm/themes/breeze/theme.conf.user
    if [ -d /usr/share/sddm/themes/breeze ] && [ ! -e "$conf" ]; then
        printf '[General]\nbackground=/usr/share/wallpapers/Horizon/contents/images/3840x2160.png\ntype=image\n' > "$conf"
    fi
    command -v gtk-update-icon-cache >/dev/null && gtk-update-icon-cache -q -f /usr/share/icons/hicolor || true
    command -v update-desktop-database >/dev/null && update-desktop-database -q || true
fi
