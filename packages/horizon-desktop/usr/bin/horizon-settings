    QFileDialog, QFrame, QGridLayout, QHBoxLayout, QLabel, QLineEdit, QListWidget,
    QListWidgetItem, QMainWindow, QMessageBox, QPushButton, QScrollArea, QSlider,
    QSpinBox, QStackedWidget, QToolButton, QVBoxLayout, QWidget,
)

try:
    from PyQt6.QtDBus import QDBusConnection, QDBusInterface
except ImportError:  # pragma: no cover - fall back to dbus-send
    QDBusConnection = None

