STYLE = """
QListWidget#sidebar { border: none; background: transparent; padding: 8px; }
QListWidget#sidebar::item { padding: 8px 10px; border-radius: 8px; margin: 1px 0; }
QListWidget#sidebar::item:selected { background: palette(highlight); color: palette(highlighted-text); }
QFrame#card { background: palette(base); border-radius: 12px; border: 1px solid palette(midlight); }
QToolButton#choice { border: 2px solid transparent; border-radius: 12px; padding: 8px; }
QToolButton#choice:hover { background: palette(midlight); }
QToolButton#choice:checked { border-color: palette(highlight); }
QPushButton#primary { background: palette(highlight); color: palette(highlighted-text);
                      border-radius: 8px; padding: 6px 18px; font-weight: 600; }
QLabel#kbd { font-family: monospace; }
"""

PAGES = [
    ("welcome", "Welcome", "horizon-logo"),
    ("appearance", "Appearance", "preferences-desktop-theme"),
    ("dock", "Dock & Menu Bar", "preferences-desktop"),
    ("windows", "Windows & Animations", "preferences-system-windows-effect"),
    ("boot", "Boot & UEFI", "preferences-system-startup"),
    ("about", "About", "help-about"),
]


class MainWindow(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle(APP_NAME)
        self.setWindowIcon(QIcon.fromTheme("horizon-logo"))
        self.resize(980, 680)

        central = QWidget()
        h = QHBoxLayout(central)
        h.setContentsMargins(0, 0, 0, 0)
        h.setSpacing(0)
        self.sidebar = QListWidget()
        self.sidebar.setObjectName("sidebar")
        self.sidebar.setFixedWidth(230)
        self.sidebar.setIconSize(QSize(22, 22))
        self.stack = QStackedWidget()
        h.addWidget(self.sidebar)
        line = QFrame()
        line.setFrameShape(QFrame.Shape.VLine)
        line.setFrameShadow(QFrame.Shadow.Plain)
        line.setStyleSheet("color: palette(midlight);")
        h.addWidget(line)
        h.addWidget(self.stack, 1)
        self.setCentralWidget(central)

        builders = {
            "welcome": lambda: WelcomePage(self),
            "appearance": AppearancePage,
            "dock": DockPage,
            "windows": WindowsPage,
            "boot": BootPage,
            "about": AboutPage,
        }
        self.keys = []
        for key, label, icon in PAGES:
            item = QListWidgetItem(QIcon.fromTheme(icon, QIcon.fromTheme("preferences-system")), label)
            self.sidebar.addItem(item)
            self.stack.addWidget(builders[key]())
            self.keys.append(key)
        self.sidebar.currentRowChanged.connect(self.stack.setCurrentIndex)
        self.sidebar.setCurrentRow(0)

    def show_page(self, key):
        if key in self.keys:
            self.sidebar.setCurrentRow(self.keys.index(key))


def should_show_welcome():
    if is_live_session():
        return True
    shown = kread("horizon-settingsrc", ["Welcome"], "Shown", "false") == "true"
    always = kread("horizon-settingsrc", ["Welcome"], "ShowOnStartup", "false") == "true"
    return always or not shown


ACCENT_NAMES = {name.lower(): color for name, color in ACCENTS}
VISIBILITY = {"always": "none", "dodge": "dodgewindows", "auto": "autohide",
              "none": "none", "dodgewindows": "dodgewindows", "autohide": "autohide"}
LAYOUT_ALIASES = {"macos": "macos", "mac": "macos", "focus": "focus", "classic": "windows", "windows": "windows"}
ON = ("on", "true", "yes", "1")


def cli_set(pairs):
    """Non-GUI changes, used by the `horizon` command: KEY=VALUE pairs."""
    from PyQt6.QtCore import QCoreApplication
    QCoreApplication([sys.argv[0]])  # needed for D-Bus
    errors = 0
    for pair in pairs:
        key, _, value = pair.partition("=")
        value = value.strip()
        try:
            if key == "mode" and value in ("light", "dark"):
                apply_mode(value)
            elif key == "accent":
                color = ACCENT_NAMES.get(value.lower(), value)
                if not QColor(color).isValid():
                    raise ValueError(f"unknown colour '{value}'")
                apply_accent(QColor(color).name())
            elif key == "layout" and value in LAYOUT_ALIASES:
                apply_layout(LAYOUT_ALIASES[value])
            elif key == "dock-position" and value in ("bottom", "left", "right"):
                dock_update(f"p.location = {js(value)};")
            elif key == "dock-size" and value.isdigit():
                dock_update(f"p.height = {max(24, min(160, int(value)))};")
            elif key == "dock-alignment" and value in ("left", "center", "right"):
                dock_update(f"p.alignment = {js(value)};")
            elif key == "dock-visibility" and value in VISIBILITY:
                dock_update(f"p.hiding = {js(VISIBILITY[value])};")
            elif key == "dock-floating":
                dock_update(f"p.floating = {js(value.lower() in ON)};")
            elif key in ("dock-pin", "dock-unpin"):
                entry = normalize_app(value)
                launchers = (panel_state().get("dock") or {}).get("launchers", [])
                if key == "dock-pin" and entry not in launchers:
                    launchers.append(entry)
                elif key == "dock-unpin":
                    launchers = [l for l in launchers if l != entry]
                dock_set_launchers(launchers)
            elif key == "buttons" and value in ("left", "right"):
                set_title_buttons(value)
            elif key == "animations":
                factor = dict((label.lower(), f) for label, f in ANIMATION_SPEEDS).get(value.lower())
                if factor is None:
                    raise ValueError("use one of: " + ", ".join(l.lower() for l, _ in ANIMATION_SPEEDS))
                set_animation_speed(factor)
            elif key in ("wobbly", "blur"):
                toggle_effect("wobblywindows" if key == "wobbly" else "blur", value.lower() in ON)
            else:
                raise ValueError("unknown setting or value")
            print(f"✓ {key} = {value}")
        except ValueError as exc:
            print(f"✗ {pair}: {exc}", file=sys.stderr)
            errors += 1
    return 1 if errors else 0


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--page", choices=[p[0] for p in PAGES], help="page to open")
    parser.add_argument("--welcome", action="store_true",
                        help="autostart mode: show the welcome page on first login only")
    parser.add_argument("--set", nargs="+", metavar="KEY=VALUE",
                        help="change settings without opening the window: mode, accent, layout, "
                             "dock-position, dock-size, dock-alignment, dock-visibility, dock-floating, "
                             "dock-pin, dock-unpin, buttons, animations, wobbly, blur")
    args, qt_args = parser.parse_known_args()

    if args.set:
        return cli_set(args.set)

    if args.welcome:
        if not should_show_welcome():
            return 0
        kwrite("horizon-settingsrc", ["Welcome"], "Shown", "true")

    app = QApplication([sys.argv[0]] + qt_args)
    app.setApplicationName("horizon-settings")
    app.setApplicationDisplayName(APP_NAME)
    app.setDesktopFileName("org.horizon.settings")
    app.setStyleSheet(STYLE)
    win = MainWindow()
    win.show_page(args.page or "welcome")
    win.show()
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
