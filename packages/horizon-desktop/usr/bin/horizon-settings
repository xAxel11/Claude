        "desktoptheme": ["WhiteSur-dark", "WhiteSurDark", "breeze-dark"],
        "decoration": ["WhiteSur-dark", "WhiteSurDark"],
        "kvantum": ["WhiteSurDark", "WhiteSur-dark"],
        "icons": ["WhiteSur-dark", "WhiteSurDark", "breeze-dark"],
    },
}

