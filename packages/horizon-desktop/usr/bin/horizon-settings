# --------------------------------------------------------------------------
# KDE config files
# --------------------------------------------------------------------------

def _config_paths(name):
    return [CONFIG_HOME / name] + [Path(d) / name for d in
                                   os.environ.get("XDG_CONFIG_DIRS", "/etc/xdg").split(":")]


def _header(groups):
    return "".join(f"[{g}]" for g in groups)


def kread(name, groups, key, default=None):
    """Read a KConfig value, honouring user config over /etc/xdg defaults."""
    want = _header(groups)
    for path in _config_paths(name):
        try:
            lines = path.read_text(encoding="utf-8").splitlines()
        except OSError:
            continue
        current = None
        for line in lines:
            s = line.strip()
            if s.startswith("["):
                current = s
            elif current == want and "=" in s:
                k, v = s.split("=", 1)
                if k.strip().split("[$")[0] == key:
                    return v
    return default


def kwrite(name, groups, key, value):
    """Write (or delete with value=None) a key in ~/.config/<name>."""
    tool = shutil.which("kwriteconfig6")
    if tool:
        cmd = [tool, "--file", name]
        for g in groups:
            cmd += ["--group", g]
        cmd += ["--key", key]
        cmd += ["--delete"] if value is None else ["--notify", str(value)]
        if subprocess.run(cmd, check=False).returncode == 0:
            return

    path = CONFIG_HOME / name
    path.parent.mkdir(parents=True, exist_ok=True)
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except OSError:
        lines = []
    want = _header(groups)
    start = end = None
    for i, line in enumerate(lines):
        s = line.strip()
        if s == want:
            start, end = i, len(lines)
        elif start is not None and s.startswith("[") and i > start:
            end = i
            break
    entry = None if value is None else f"{key}={value}"
    if start is None:
        if entry:
            if lines and lines[-1].strip():
                lines.append("")
            lines += [want, entry]
    else:
        for i in range(start + 1, end):
            if lines[i].split("=", 1)[0].strip() == key:
                if entry:
                    lines[i] = entry
                else:
                    del lines[i]
                break
        else:
            if entry:
                insert = end
                while insert > start + 1 and not lines[insert - 1].strip():
                    insert -= 1
                lines.insert(insert, entry)
    path.write_text("\n".join(lines) + "\n", encoding="utf-8")


# --------------------------------------------------------------------------
# Talking to Plasma
# --------------------------------------------------------------------------

def run(*cmd):
    try:
        return subprocess.run(cmd, check=False, capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.TimeoutExpired) as exc:
        print(f"horizon-settings: {cmd[0]}: {exc}", file=sys.stderr)
        return None


def dbus_call(service, path, interface, method, *args):
    """Call a session-bus method; returns the first reply argument or None."""
    if QDBusConnection is not None:
        iface = QDBusInterface(service, path, interface, QDBusConnection.sessionBus())
        if iface.isValid():
            reply = iface.call(method, *args)
            values = reply.arguments()
            return values[0] if values else None
    cmd = ["dbus-send", "--session", "--print-reply", f"--dest={service}", path, f"{interface}.{method}"]
    for a in args:
        cmd.append(f"boolean:{str(a).lower()}" if isinstance(a, bool) else f"string:{a}")
    res = run(*cmd)
    if res and res.returncode == 0:
        out = res.stdout.split("string ", 1)
        if len(out) == 2:
            return out[1].strip().strip('"')
    return None


def plasma_script(script):
    return dbus_call("org.kde.plasmashell", "/PlasmaShell", "org.kde.PlasmaShell", "evaluateScript", script)


def kwin_reconfigure():
    dbus_call("org.kde.KWin", "/KWin", "org.kde.KWin", "reconfigure")


def kwin_effect(name, enabled):
    kwrite("kwinrc", ["Plugins"], f"{name}Enabled", "true" if enabled else "false")
    dbus_call("org.kde.KWin", "/Effects", "org.kde.kwin.Effects",
              "loadEffect" if enabled else "unloadEffect", name)


def libexec(tool):
    for pattern in (f"/usr/lib/*/libexec/{tool}", f"/usr/libexec/{tool}", f"/usr/lib/libexec/{tool}"):
        hits = glob.glob(pattern)
        if hits:
            return hits[0]
    return shutil.which(tool)


def first_installed(kind, candidates):
    roots = {
        "colorscheme": ["/usr/share/color-schemes/{}.colors", "~/.local/share/color-schemes/{}.colors"],
        "desktoptheme": ["/usr/share/plasma/desktoptheme/{}", "~/.local/share/plasma/desktoptheme/{}"],
        "decoration": ["/usr/share/aurorae/themes/{}", "~/.local/share/aurorae/themes/{}"],
        # Kvantum keeps variants (e.g. WhiteSurDark) inside the base theme's folder.
        "kvantum": ["/usr/share/Kvantum/{}", "/usr/share/Kvantum/*/{}.kvconfig", "~/.config/Kvantum/{}"],
        "icons": ["/usr/share/icons/{}/index.theme", "~/.local/share/icons/{}/index.theme"],
    }[kind]
    for name in candidates:
        if any(glob.glob(os.path.expanduser(r.format(name))) for r in roots):
            return name
    return None


def icon_themes():
    names = set()
    for base in ("/usr/share/icons", os.path.expanduser("~/.local/share/icons")):
        for index in glob.glob(f"{base}/*/index.theme"):
            text = Path(index).read_text(errors="ignore")
            if "Directories=" in text and "cursors" not in Path(index).parent.name.lower():
                names.add(Path(index).parent.name)
    names.discard("default")
    names.discard("hicolor")
    return sorted(names, key=str.lower)


def is_live_session():
    try:
        return "boot=casper" in Path("/proc/cmdline").read_text()
    except OSError:
        return False


def os_release():
    info = {}
    for p in ("/etc/os-release", "/usr/lib/os-release"):
        try:
            for line in Path(p).read_text().splitlines():
                if "=" in line:
                    k, v = line.split("=", 1)
                    info[k] = v.strip().strip('"')
            break
        except OSError:
            continue
    return info


# --------------------------------------------------------------------------
# Small UI building blocks
# --------------------------------------------------------------------------

def heading(text, size=20):
    label = QLabel(text)
    font = label.font()
    font.setPointSizeF(size * 0.75 + 3)
    font.setWeight(QFont.Weight.DemiBold)
    label.setFont(font)
    return label


def muted(text):
    label = QLabel(text)
    label.setWordWrap(True)
    label.setStyleSheet("color: palette(placeholder-text);")
    return label


class Card(QFrame):
    """A rounded group box, like a section in macOS System Settings."""

    def __init__(self, title=None):
        super().__init__()
        self.setObjectName("card")
        self.box = QVBoxLayout(self)
        self.box.setContentsMargins(18, 14, 18, 16)
        self.box.setSpacing(10)
        if title:
            self.box.addWidget(heading(title, 13))

    def row(self, label, widget, hint=None):
        line = QHBoxLayout()
        text = QVBoxLayout()
        text.setSpacing(2)
        text.addWidget(QLabel(label))
        if hint:
            text.addWidget(muted(hint))
        line.addLayout(text, 1)
        line.addWidget(widget, 0, Qt.AlignmentFlag.AlignRight | Qt.AlignmentFlag.AlignVCenter)
        self.box.addLayout(line)
        return widget


class Page(QScrollArea):
    def __init__(self, title, subtitle=None):
        super().__init__()
        self.setWidgetResizable(True)
        self.setFrameShape(QFrame.Shape.NoFrame)
        inner = QWidget()
        self.box = QVBoxLayout(inner)
        self.box.setContentsMargins(28, 24, 28, 24)
        self.box.setSpacing(16)
        self.box.addWidget(heading(title, 26))
        if subtitle:
            self.box.addWidget(muted(subtitle))
        self.setWidget(inner)

    def add(self, widget):
        self.box.addWidget(widget)
        return widget

    def finish(self):
        self.box.addStretch(1)


def swatch_icon(color, selected=False, size=28):
    pix = QPixmap(size, size)
    pix.fill(Qt.GlobalColor.transparent)
    p = QPainter(pix)
    p.setRenderHint(QPainter.RenderHint.Antialiasing)
    p.setPen(Qt.PenStyle.NoPen)
    p.setBrush(QColor(color))
    p.drawEllipse(2, 2, size - 4, size - 4)
    if selected:
        p.setBrush(QColor("white"))
        p.drawEllipse(size // 2 - 4, size // 2 - 4, 8, 8)
    p.end()
    return QIcon(pix)


class ChoiceCards(QWidget):
    """Big clickable cards (e.g. Light / Dark) — exactly one is selected."""

    def __init__(self, options, on_pick, icon_size=QSize(150, 90)):
        super().__init__()
        self.group = QButtonGroup(self)
        self.group.setExclusive(True)
        grid = QHBoxLayout(self)
        grid.setContentsMargins(0, 0, 0, 0)
        grid.setSpacing(14)
        self.buttons = {}
        for key, label, icon in options:
            btn = QToolButton()
            btn.setText(label)
            btn.setCheckable(True)
            btn.setToolButtonStyle(Qt.ToolButtonStyle.ToolButtonTextUnderIcon)
            btn.setIconSize(icon_size)
            if icon is not None:
                btn.setIcon(icon)
            btn.setObjectName("choice")
            btn.clicked.connect(lambda _=False, k=key: on_pick(k))
            self.group.addButton(btn)
            self.buttons[key] = btn
            grid.addWidget(btn)
        grid.addStretch(1)

    def select(self, key):
        if key in self.buttons:
            self.buttons[key].setChecked(True)


def mode_preview(dark):
    """Tiny drawing of a desktop in light or dark mode."""
    w, h = 150, 90
    pix = QPixmap(w, h)
    pix.fill(Qt.GlobalColor.transparent)
    p = QPainter(pix)
    p.setRenderHint(QPainter.RenderHint.Antialiasing)
    p.setPen(Qt.PenStyle.NoPen)
    p.setBrush(QColor("#1d1b4b" if dark else "#a9c8ff"))
    p.drawRoundedRect(0, 0, w, h, 10, 10)
    p.setBrush(QColor("#2b2b30" if dark else "#f5f5f7"))
    p.drawRect(0, 0, w, 9)
    p.drawRoundedRect(22, 20, 90, 50, 6, 6)
    for i, c in enumerate(("#ff5f57", "#febc2e", "#28c840")):
        p.setBrush(QColor(c))
        p.drawEllipse(28 + i * 9, 25, 6, 6)
    p.setBrush(QColor(255, 255, 255, 90 if dark else 160))
    p.drawRoundedRect(45, 76, 60, 11, 4, 4)
    p.end()
    return QIcon(pix)


def titlebar_preview(side):
    w, h = 150, 40
    pix = QPixmap(w, h)
    pix.fill(Qt.GlobalColor.transparent)
    p = QPainter(pix)
    p.setRenderHint(QPainter.RenderHint.Antialiasing)
    p.setPen(QColor(0, 0, 0, 40))
    p.setBrush(QColor("#f5f5f7"))
    p.drawRoundedRect(1, 1, w - 2, h - 2, 8, 8)
    p.setPen(Qt.PenStyle.NoPen)
    x0 = 10 if side == "left" else w - 44
    colors = ("#ff5f57", "#febc2e", "#28c840") if side == "left" else ("#febc2e", "#28c840", "#ff5f57")
    for i, c in enumerate(colors):
        p.setBrush(QColor(c))
        p.drawEllipse(x0 + i * 12, 15, 10, 10)
    p.setBrush(QColor(0, 0, 0, 50))
    p.drawRoundedRect(55, 17, 40, 6, 3, 3)
    p.end()
    return QIcon(pix)


def layout_preview(key):
    w, h = 150, 90
    pix = QPixmap(w, h)
    pix.fill(Qt.GlobalColor.transparent)
    p = QPainter(pix)
    p.setRenderHint(QPainter.RenderHint.Antialiasing)
    p.setPen(Qt.PenStyle.NoPen)
    p.setBrush(QColor("#6f8fe8"))
    p.drawRoundedRect(0, 0, w, h, 10, 10)
    bar = QColor(255, 255, 255, 220)
    p.setBrush(bar)
    if key == "macos":
        p.drawRect(0, 0, w, 8)
        p.drawRoundedRect(40, 74, 70, 12, 4, 4)
    elif key == "focus":
        p.drawRect(0, 0, w, 7)
        p.setBrush(QColor(255, 255, 255, 90))
        p.drawRoundedRect(50, 77, 50, 9, 4, 4)
    else:
        p.drawRoundedRect(4, 74, w - 8, 12, 4, 4)
        p.setBrush(QColor("#0a84ff"))
        p.drawEllipse(9, 76, 8, 8)
    p.end()
    return QIcon(pix)


# --------------------------------------------------------------------------
# Pages
