    ("Blue", "#007AFF"), ("Purple", "#AF52DE"), ("Pink", "#FF2D55"),
    ("Red", "#FF3B30"), ("Orange", "#FF9500"), ("Yellow", "#FFCC00"),
    ("Green", "#34C759"), ("Graphite", "#8E8E93"),
]

# Theme pieces for light/dark mode. The first candidate that is installed wins,
# so the app keeps working if an upstream theme renames a variant.
