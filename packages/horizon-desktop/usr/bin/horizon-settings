# --------------------------------------------------------------------------
# KDE config files
# --------------------------------------------------------------------------

def _config_paths(name):
    return [CONFIG_HOME / name] + [Path(d) / name for d in
                                   os.environ.get("XDG_CONFIG_DIRS", "/etc/xdg").split(":")]


def _header(groups):
    return "".join(f"[{g}]" for g in groups)


def kread(name, groups, key, default=None):
    """Read a KConfig value, honouring user config over /etc/xdg defaults."""
    want = _header(groups)
    for path in _config_paths(name):
        try:
            lines = path.read_text(encoding="utf-8").splitlines()
        except OSError:
            continue
        current = None
        for line in lines:
            s = line.strip()
            if s.startswith("["):
                current = s
            elif current == want and "=" in s:
                k, v = s.split("=", 1)
                if k.strip().split("[$")[0] == key:
                    return v
    return default


def kwrite(name, groups, key, value):
    """Write (or delete with value=None) a key in ~/.config/<name>."""
    tool = shutil.which("kwriteconfig6")
    if tool:
        cmd = [tool, "--file", name]
        for g in groups:
            cmd += ["--group", g]
        cmd += ["--key", key]
        cmd += ["--delete"] if value is None else ["--notify", str(value)]
        if subprocess.run(cmd, check=False).returncode == 0:
            return

    path = CONFIG_HOME / name
    path.parent.mkdir(parents=True, exist_ok=True)
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except OSError:
        lines = []
    want = _header(groups)
    start = end = None
    for i, line in enumerate(lines):
        s = line.strip()
        if s == want:
            start, end = i, len(lines)
        elif start is not None and s.startswith("[") and i > start:
            end = i
            break
    entry = None if value is None else f"{key}={value}"
    if start is None:
        if entry:
            if lines and lines[-1].strip():
                lines.append("")
            lines += [want, entry]
    else:
        for i in range(start + 1, end):
            if lines[i].split("=", 1)[0].strip() == key:
                if entry:
                    lines[i] = entry
                else:
                    del lines[i]
                break
        else:
            if entry:
                insert = end
                while insert > start + 1 and not lines[insert - 1].strip():
                    insert -= 1
                lines.insert(insert, entry)
    path.write_text("\n".join(lines) + "\n", encoding="utf-8")


# --------------------------------------------------------------------------
# Talking to Plasma
# --------------------------------------------------------------------------

def run(*cmd):
    try:
        return subprocess.run(cmd, check=False, capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.TimeoutExpired) as exc:
        print(f"horizon-settings: {cmd[0]}: {exc}", file=sys.stderr)
        return None


def dbus_call(service, path, interface, method, *args):
    """Call a session-bus method; returns the first reply argument or None."""
    if QDBusConnection is not None:
        iface = QDBusInterface(service, path, interface, QDBusConnection.sessionBus())
        if iface.isValid():
            reply = iface.call(method, *args)
            values = reply.arguments()
            return values[0] if values else None
    cmd = ["dbus-send", "--session", "--print-reply", f"--dest={service}", path, f"{interface}.{method}"]
    for a in args:
        cmd.append(f"boolean:{str(a).lower()}" if isinstance(a, bool) else f"string:{a}")
    res = run(*cmd)
    if res and res.returncode == 0:
        out = res.stdout.split("string ", 1)
        if len(out) == 2:
            return out[1].strip().strip('"')
    return None


def plasma_script(script):
    return dbus_call("org.kde.plasmashell", "/PlasmaShell", "org.kde.PlasmaShell", "evaluateScript", script)


def kwin_reconfigure():
    dbus_call("org.kde.KWin", "/KWin", "org.kde.KWin", "reconfigure")


def kwin_effect(name, enabled):
    kwrite("kwinrc", ["Plugins"], f"{name}Enabled", "true" if enabled else "false")
    dbus_call("org.kde.KWin", "/Effects", "org.kde.kwin.Effects",
              "loadEffect" if enabled else "unloadEffect", name)


def libexec(tool):
    for pattern in (f"/usr/lib/*/libexec/{tool}", f"/usr/libexec/{tool}", f"/usr/lib/libexec/{tool}"):
        hits = glob.glob(pattern)
        if hits:
            return hits[0]
    return shutil.which(tool)


def first_installed(kind, candidates):
    roots = {
        "colorscheme": ["/usr/share/color-schemes/{}.colors", "~/.local/share/color-schemes/{}.colors"],
        "desktoptheme": ["/usr/share/plasma/desktoptheme/{}", "~/.local/share/plasma/desktoptheme/{}"],
        "decoration": ["/usr/share/aurorae/themes/{}", "~/.local/share/aurorae/themes/{}"],
        # Kvantum keeps variants (e.g. WhiteSurDark) inside the base theme's folder.
        "kvantum": ["/usr/share/Kvantum/{}", "/usr/share/Kvantum/*/{}.kvconfig", "~/.config/Kvantum/{}"],
        "icons": ["/usr/share/icons/{}/index.theme", "~/.local/share/icons/{}/index.theme"],
    }[kind]
    for name in candidates:
        if any(glob.glob(os.path.expanduser(r.format(name))) for r in roots):
            return name
    return None


def icon_themes():
    names = set()
    for base in ("/usr/share/icons", os.path.expanduser("~/.local/share/icons")):
        for index in glob.glob(f"{base}/*/index.theme"):
            text = Path(index).read_text(errors="ignore")
            if "Directories=" in text and "cursors" not in Path(index).parent.name.lower():
                names.add(Path(index).parent.name)
    names.discard("default")
    names.discard("hicolor")
    return sorted(names, key=str.lower)


def is_live_session():
    try:
        return "boot=casper" in Path("/proc/cmdline").read_text()
    except OSError:
        return False


def os_release():
    info = {}
    for p in ("/etc/os-release", "/usr/lib/os-release"):
        try:
            for line in Path(p).read_text().splitlines():
                if "=" in line:
                    k, v = line.split("=", 1)
                    info[k] = v.strip().strip('"')
            break
        except OSError:
            continue
    return info


# --------------------------------------------------------------------------
# Actions shared by the GUI and the command line (horizon-settings --set …)
# --------------------------------------------------------------------------

def apply_accent(color):
    run("plasma-apply-colorscheme", "--accent-color", color)
    kwrite("horizon-settingsrc", ["Appearance"], "Accent", color)


def apply_icons(name):
    tool = libexec("plasma-changeicons")
    if tool:
        run(tool, name)
    else:
        kwrite("kdeglobals", ["Icons"], "Theme", name)


def apply_mode(mode):
    """Switch every theme piece to its light or dark variant; returns the icon theme used."""
    v = THEME_VARIANTS[mode]
    scheme = first_installed("colorscheme", v["colorscheme"])
    if scheme:
        run("plasma-apply-colorscheme", scheme)
    theme = first_installed("desktoptheme", v["desktoptheme"])
    if theme:
        run("plasma-apply-desktoptheme", theme)
    deco = first_installed("decoration", v["decoration"])
    if deco:
        kwrite("kwinrc", ["org.kde.kdecoration2"], "library", "org.kde.kwin.aurorae")
        kwrite("kwinrc", ["org.kde.kdecoration2"], "theme", f"__aurorae__svg__{deco}")
        kwin_reconfigure()
    kv = first_installed("kvantum", v["kvantum"])
    if kv:
        kwrite("Kvantum/kvantum.kvconfig", ["General"], "theme", kv)
    icons = first_installed("icons", v["icons"])
    if icons:
        apply_icons(icons)
    accent = kread("horizon-settingsrc", ["Appearance"], "Accent")
    if accent:
        run("plasma-apply-colorscheme", "--accent-color", accent)
    kwrite("horizon-settingsrc", ["Appearance"], "Mode", mode)
    return icons


def set_title_buttons(side):
    left, right = ("XIA", "") if side == "left" else ("M", "IAX")
    kwrite("kwinrc", ["org.kde.kdecoration2"], "ButtonsOnLeft", left)
    kwrite("kwinrc", ["org.kde.kdecoration2"], "ButtonsOnRight", right)
    kwin_reconfigure()


def set_animation_speed(factor):
    kwrite("kdeglobals", ["KDE"], "AnimationDurationFactor", factor)
    kwin_reconfigure()


def set_exclusive_effect(options, chosen):
    for _, eff in options:
        if eff:
            kwin_effect(eff, eff == chosen)
    kwin_reconfigure()


def toggle_effect(name, on):
    kwin_effect(name, on)
    kwin_reconfigure()


# --------------------------------------------------------------------------
# Small UI building blocks
# --------------------------------------------------------------------------

def heading(text, size=20):
    label = QLabel(text)
    font = label.font()
    font.setPointSizeF(size * 0.75 + 3)
    font.setWeight(QFont.Weight.DemiBold)
    label.setFont(font)
    return label


def muted(text):
    label = QLabel(text)
    label.setWordWrap(True)
    label.setStyleSheet("color: palette(placeholder-text);")
    return label


class Card(QFrame):
    """A rounded group box, like a section in macOS System Settings."""

    def __init__(self, title=None):
        super().__init__()
        self.setObjectName("card")
        self.box = QVBoxLayout(self)
        self.box.setContentsMargins(18, 14, 18, 16)
        self.box.setSpacing(10)
        if title:
            self.box.addWidget(heading(title, 13))

    def row(self, label, widget, hint=None):
        line = QHBoxLayout()
        text = QVBoxLayout()
        text.setSpacing(2)
        title = QLabel(label)
        title.setWordWrap(True)
        text.addWidget(title)
        if hint:
            text.addWidget(muted(hint))
        line.addLayout(text, 1)
        line.addWidget(widget, 0, Qt.AlignmentFlag.AlignRight | Qt.AlignmentFlag.AlignVCenter)
        self.box.addLayout(line)
        return widget


class Page(QScrollArea):
    def __init__(self, title, subtitle=None):
        super().__init__()
        self.setWidgetResizable(True)
        self.setFrameShape(QFrame.Shape.NoFrame)
        self.setHorizontalScrollBarPolicy(Qt.ScrollBarPolicy.ScrollBarAlwaysOff)
        inner = QWidget()
        self.box = QVBoxLayout(inner)
        self.box.setContentsMargins(28, 24, 28, 24)
        self.box.setSpacing(16)
        self.box.addWidget(heading(title, 26))
        if subtitle:
            self.box.addWidget(muted(subtitle))
        self.setWidget(inner)

    def add(self, widget):
        self.box.addWidget(widget)
        return widget

    def finish(self):
        self.box.addStretch(1)


def swatch_icon(color, selected=False, size=28):
    pix = QPixmap(size, size)
    pix.fill(Qt.GlobalColor.transparent)
    p = QPainter(pix)
    p.setRenderHint(QPainter.RenderHint.Antialiasing)
    p.setPen(Qt.PenStyle.NoPen)
    p.setBrush(QColor(color))
    p.drawEllipse(2, 2, size - 4, size - 4)
    if selected:
        p.setBrush(QColor("white"))
        p.drawEllipse(size // 2 - 4, size // 2 - 4, 8, 8)
    p.end()
    return QIcon(pix)


class ChoiceCards(QWidget):
    """Big clickable cards (e.g. Light / Dark) — exactly one is selected."""

    def __init__(self, options, on_pick, icon_size=QSize(150, 90)):
        super().__init__()
        self.group = QButtonGroup(self)
        self.group.setExclusive(True)
        grid = QHBoxLayout(self)
        grid.setContentsMargins(0, 0, 0, 0)
        grid.setSpacing(14)
        self.buttons = {}
        for key, label, icon in options:
            btn = QToolButton()
            btn.setText(label)
            btn.setCheckable(True)
            btn.setToolButtonStyle(Qt.ToolButtonStyle.ToolButtonTextUnderIcon)
            btn.setIconSize(icon_size)
            if icon is not None:
                btn.setIcon(icon)
            btn.setObjectName("choice")
            btn.clicked.connect(lambda _=False, k=key: on_pick(k))
            self.group.addButton(btn)
            self.buttons[key] = btn
            grid.addWidget(btn)
        grid.addStretch(1)

    def select(self, key):
        if key in self.buttons:
            self.buttons[key].setChecked(True)


def mode_preview(dark):
    """Tiny drawing of a desktop in light or dark mode."""
    w, h = 150, 90
    pix = QPixmap(w, h)
    pix.fill(Qt.GlobalColor.transparent)
    p = QPainter(pix)
    p.setRenderHint(QPainter.RenderHint.Antialiasing)
    p.setPen(Qt.PenStyle.NoPen)
    p.setBrush(QColor("#1d1b4b" if dark else "#a9c8ff"))
    p.drawRoundedRect(0, 0, w, h, 10, 10)
    p.setBrush(QColor("#2b2b30" if dark else "#f5f5f7"))
    p.drawRect(0, 0, w, 9)
    p.drawRoundedRect(22, 20, 90, 50, 6, 6)
    for i, c in enumerate(("#ff5f57", "#febc2e", "#28c840")):
        p.setBrush(QColor(c))
        p.drawEllipse(28 + i * 9, 25, 6, 6)
    p.setBrush(QColor(255, 255, 255, 90 if dark else 160))
    p.drawRoundedRect(45, 76, 60, 11, 4, 4)
    p.end()
    return QIcon(pix)


def titlebar_preview(side):
    w, h = 150, 40
    pix = QPixmap(w, h)
    pix.fill(Qt.GlobalColor.transparent)
    p = QPainter(pix)
    p.setRenderHint(QPainter.RenderHint.Antialiasing)
    p.setPen(QColor(0, 0, 0, 40))
    p.setBrush(QColor("#f5f5f7"))
    p.drawRoundedRect(1, 1, w - 2, h - 2, 8, 8)
    p.setPen(Qt.PenStyle.NoPen)
    x0 = 10 if side == "left" else w - 44
    colors = ("#ff5f57", "#febc2e", "#28c840") if side == "left" else ("#febc2e", "#28c840", "#ff5f57")
    for i, c in enumerate(colors):
        p.setBrush(QColor(c))
        p.drawEllipse(x0 + i * 12, 15, 10, 10)
    p.setBrush(QColor(0, 0, 0, 50))
    p.drawRoundedRect(55, 17, 40, 6, 3, 3)
    p.end()
    return QIcon(pix)


def layout_preview(key):
    w, h = 150, 90
    pix = QPixmap(w, h)
    pix.fill(Qt.GlobalColor.transparent)
    p = QPainter(pix)
    p.setRenderHint(QPainter.RenderHint.Antialiasing)
    p.setPen(Qt.PenStyle.NoPen)
    p.setBrush(QColor("#6f8fe8"))
    p.drawRoundedRect(0, 0, w, h, 10, 10)
    bar = QColor(255, 255, 255, 220)
    p.setBrush(bar)
    if key == "macos":
        p.drawRect(0, 0, w, 8)
        p.drawRoundedRect(40, 74, 70, 12, 4, 4)
    elif key == "focus":
        p.drawRect(0, 0, w, 7)
        p.setBrush(QColor(255, 255, 255, 90))
        p.drawRoundedRect(50, 77, 50, 9, 4, 4)
    else:
        p.drawRoundedRect(4, 74, w - 8, 12, 4, 4)
        p.setBrush(QColor("#0a84ff"))
        p.drawEllipse(9, 76, 8, 8)
    p.end()
    return QIcon(pix)


# --------------------------------------------------------------------------
# Pages
# --------------------------------------------------------------------------

class WelcomePage(Page):
    def __init__(self, window):
        super().__init__(f"Welcome to {DISTRO_NAME}")
        self.main = window
        logo = QLabel()
        logo.setPixmap(QIcon.fromTheme("horizon-logo").pixmap(96, 96))
        self.box.insertWidget(0, logo)
        self.add(muted("A beautiful, private and fast desktop built on Ubuntu. "
                       "Here are a few things to get you started."))

        if is_live_session():
            card = self.add(Card("You are running the live system"))
            card.box.addWidget(muted("Nothing is changed on your computer until you install. "
                                     "The installer guides you through partitioning, your account and more."))
            btn = QPushButton(QIcon.fromTheme("system-software-install"), f"  Install {DISTRO_NAME}…")
            btn.setObjectName("primary")
            btn.setMinimumHeight(38)
            btn.clicked.connect(self.install)
            card.box.addWidget(btn, 0, Qt.AlignmentFlag.AlignLeft)

        steps = self.add(Card("Make it yours"))
        grid = QGridLayout()
        grid.setSpacing(10)
        items = [
            ("preferences-desktop-theme", "Light or dark", "appearance"),
            ("preferences-desktop", "Dock && layout", "dock"),
            ("preferences-system-windows-effect", "Animations", "windows"),
            ("plasmadiscover", "Get apps", None),
        ]
        for i, (icon, text, page) in enumerate(items):
            b = QToolButton()
            b.setIcon(QIcon.fromTheme(icon, QIcon.fromTheme("preferences-system")))
            b.setIconSize(QSize(40, 40))
            b.setText(text)
            b.setToolButtonStyle(Qt.ToolButtonStyle.ToolButtonTextUnderIcon)
            b.setMinimumSize(130, 90)
            b.setObjectName("choice")
            if page:
                b.clicked.connect(lambda _=False, pg=page: self.main.show_page(pg))
            else:
                b.clicked.connect(lambda: subprocess.Popen(["plasma-discover"]))
            grid.addWidget(b, 0, i)
        steps.box.addLayout(grid)

        tips = self.add(Card("Handy shortcuts"))
        for keys, what in [
            ("Alt + Space", "Search apps, files and the web (like Spotlight)"),
            ("Meta + W", "Overview of all windows and desktops (like Mission Control)"),
            ("Meta", "Open the application menu"),
            ("Meta + Ctrl + ← / →", "Switch between desktops"),
            ("Meta + Print", "Take a screenshot"),
        ]:
            line = QHBoxLayout()
            k = QLabel(keys)
            k.setObjectName("kbd")
            k.setMinimumWidth(170)
            line.addWidget(k)
            line.addWidget(QLabel(what), 1)
            tips.box.addLayout(line)

        cmds = self.add(Card("Terminal commands"))
        cmds.box.addWidget(muted("Open Konsole and type these — or \"horizon help\" for the full list."))
        for command, what in [
            ("horizon update", "Update apps, the system and firmware in one go"),
            ("horizon install <app>", "Install from Ubuntu, a downloaded .deb, or Flathub"),
            ("horizon doctor", "Check your system's health, with tips"),
            ("horizon uefi", "Boot mode, Secure Boot and firmware; restart into UEFI"),
            ("horizonfetch", "Show system info with the Horizon logo"),
        ]:
            line = QHBoxLayout()
            k = QLabel(command)
            k.setObjectName("kbd")
            k.setMinimumWidth(170)
            k.setTextInteractionFlags(Qt.TextInteractionFlag.TextSelectableByMouse)
            line.addWidget(k)
            line.addWidget(QLabel(what), 1)
            cmds.box.addLayout(line)
        term = QPushButton(QIcon.fromTheme("utilities-terminal"), "  Open Terminal")
        term.clicked.connect(lambda: subprocess.Popen(["konsole"]))
        cmds.box.addWidget(term, 0, Qt.AlignmentFlag.AlignLeft)

        self.startup = QCheckBox("Show this welcome screen when I log in")
        self.startup.setChecked(kread("horizon-settingsrc", ["Welcome"], "ShowOnStartup", "false") == "true")
        self.startup.toggled.connect(
            lambda on: kwrite("horizon-settingsrc", ["Welcome"], "ShowOnStartup", "true" if on else "false"))
        self.add(self.startup)
        self.finish()

    def install(self):
        for cmd in (["horizon-install"], ["sudo", "-E", "calamares"]):
            if shutil.which(cmd[0]):
                subprocess.Popen(cmd)
                return
        QMessageBox.warning(self, APP_NAME, "The installer is not available on this system.")


class AppearancePage(Page):
    def __init__(self):
        super().__init__("Appearance", "Choose how your desktop looks. Changes apply instantly.")

        mode = self.add(Card("Mode"))
        self.modes = ChoiceCards(
            [("light", "Light", mode_preview(False)), ("dark", "Dark", mode_preview(True))],
            self.set_mode)
        mode.box.addWidget(self.modes)
        scheme = kread("kdeglobals", ["General"], "ColorScheme", "WhiteSur") or ""
        self.modes.select("dark" if "dark" in scheme.lower() else "light")

        accent = self.add(Card("Accent colour"))
        accent.box.addWidget(muted("Used for buttons, selections and highlights."))
        row = QHBoxLayout()
        row.setSpacing(6)
        self.accent_buttons = {}
        current = (kread("kdeglobals", ["General"], "AccentColor", "") or "").lower()
        for name, color in ACCENTS:
            b = QToolButton()
            b.setToolTip(name)
            b.setIconSize(QSize(28, 28))
            b.setAutoRaise(True)
            b.clicked.connect(lambda _=False, c=color: self.set_accent(c))
            self.accent_buttons[color] = b
            row.addWidget(b)
        row.addStretch(1)
        accent.box.addLayout(row)
        self.accent = self._match_accent(current)
        self._paint_accents(self.accent)

        misc = self.add(Card("Theme details"))
        self.icons = QComboBox()
        self.icons.addItems(icon_themes())
        self.icons.setCurrentText(kread("kdeglobals", ["Icons"], "Theme", "WhiteSur"))
        self.icons.currentTextChanged.connect(self.set_icons)
        misc.row("Icons", self.icons)

        wp = QPushButton("Choose picture…")
        wp.clicked.connect(self.pick_wallpaper)
        misc.row("Wallpaper", wp, "Or right-click the desktop → Desktop and Wallpaper")

        reset_wp = QPushButton(f"Use {DISTRO_NAME} wallpaper")
        reset_wp.clicked.connect(lambda: run("plasma-apply-wallpaperimage", "/usr/share/wallpapers/Horizon"))
        misc.row("", reset_wp)
        self.finish()

    @staticmethod
    def _match_accent(value):
        for _, color in ACCENTS:
            if value and QColor(value).name() == QColor(color).name():
                return color
        # KDE stores "r,g,b" — normalise.
        if value and "," in value:
            try:
                r, g, b = (int(x) for x in value.split(",")[:3])
                name = QColor(r, g, b).name()
                for _, color in ACCENTS:
                    if QColor(color).name() == name:
                        return color
            except ValueError:
                pass
        return ACCENTS[0][1] if not value else None

    def _paint_accents(self, selected):
        for color, b in self.accent_buttons.items():
            b.setIcon(swatch_icon(color, color == selected))

    def set_accent(self, color):
        apply_accent(color)
        self.accent = color
        self._paint_accents(color)

    def set_mode(self, mode):
        icons = apply_mode(mode)
        if icons:
            self.icons.blockSignals(True)
            self.icons.setCurrentText(icons)
            self.icons.blockSignals(False)

    def set_icons(self, name):
        apply_icons(name)

    def pick_wallpaper(self):
        path, _ = QFileDialog.getOpenFileName(
            self, "Choose a wallpaper", str(Path.home() / "Pictures"),
            "Images (*.png *.jpg *.jpeg *.webp *.svg)")
        if path:
            run("plasma-apply-wallpaperimage", path)


# --------------------------------------------------------------------------
# Panels: dock and top bar (shared by the GUI and `horizon-settings --set`)
# --------------------------------------------------------------------------

JS_HELPERS = """
function horizonTasks(p) {
    return [].concat(p.widgets("org.kde.plasma.icontasks"), p.widgets("org.kde.plasma.taskmanager"));
}
function horizonIsDock(p) { return horizonTasks(p).length > 0; }
function horizonIsTopBar(p) { return p.location == "top" && !horizonIsDock(p); }
"""

PANEL_QUERY = JS_HELPERS + """
var out = {dock: null, top: null};
panels().forEach(function (p) {
    if (horizonIsDock(p) && !out.dock) {
        var t = horizonTasks(p)[0];
        t.currentConfigGroup = ["General"];
        out.dock = {
            location: p.location, height: p.height, hiding: p.hiding, floating: p.floating,
            alignment: p.alignment, lengthMode: p.lengthMode,
            launchers: t.readConfig("launchers", []),
            iconSpacing: t.readConfig("iconSpacing", 1),
            groupingStrategy: t.readConfig("groupingStrategy", 1),
            showOnlyCurrentDesktop: t.readConfig("showOnlyCurrentDesktop", false),
            indicateAudioStreams: t.readConfig("indicateAudioStreams", true),
            highlightWindows: t.readConfig("highlightWindows", true),
            launchpad: p.widgets("org.kde.plasma.kickerdash").length > 0,
            trash: p.widgets("org.kde.plasma.trash").length > 0,
            classic: p.widgets("org.kde.plasma.systemtray").length > 0
        };
    } else if (horizonIsTopBar(p) && !out.top) {
        var c = p.widgets("org.kde.plasma.digitalclock");
        var ids = p.widgetIds.map(function (id) { return p.widgetById(id).type; });
        var clock = {};
        if (c.length) {
            c[0].currentConfigGroup = ["Appearance"];
            clock = {showDate: c[0].readConfig("showDate", true),
                     showSeconds: c[0].readConfig("showSeconds", 0),
                     use24hFormat: c[0].readConfig("use24hFormat", 1)};
        }
        var clockPos = ids.indexOf("org.kde.plasma.digitalclock");
        out.top = {height: p.height, floating: p.floating, clock: clock,
                   appmenu: ids.indexOf("org.kde.plasma.appmenu") >= 0,
                   centerClock: clockPos > 0 && clockPos < ids.length - 1};
    }
});
print(JSON.stringify(out));
"""


def _truthy(v, default=False):
    if isinstance(v, bool):
        return v
    if v is None:
        return default
    return str(v).lower() in ("true", "1", "2")


def panel_state():
    """Current dock/top bar settings, read live from Plasma (None when unavailable)."""
    try:
        state = json.loads(plasma_script(PANEL_QUERY) or "{}")
    except (TypeError, ValueError):
        return {}
    dock = state.get("dock")
    if dock:
        launchers = dock.get("launchers") or []
        if isinstance(launchers, str):
            launchers = [l for l in launchers.split(",") if l]
        dock["launchers"] = launchers
        for key, default in (("floating", True), ("showOnlyCurrentDesktop", False),
                             ("indicateAudioStreams", True), ("highlightWindows", True)):
            dock[key] = _truthy(dock.get(key), default)
        for key, default in (("iconSpacing", 1), ("groupingStrategy", 1), ("height", 58)):
            try:
                dock[key] = int(dock.get(key, default))
            except (TypeError, ValueError):
                dock[key] = default
    return state


def js(value):
    return json.dumps(value)


def dock_update(body):
    """Run JavaScript `body` with `p` = the dock panel and `t` = its task manager."""
    plasma_script(JS_HELPERS + """
panels().forEach(function (p) {
    if (!horizonIsDock(p)) return;
    var t = horizonTasks(p)[0];
    t.currentConfigGroup = ["General"];
    %s
    t.reloadConfig();
});
""" % body)


def dock_set_task_option(key, value):
    dock_update(f"t.writeConfig({js(key)}, {js(value)});")


def dock_set_launchers(launchers):
    dock_update(f"t.writeConfig('launchers', {js(list(launchers))});")


def normalize_app(app):
    app = app.strip()
    if app.startswith("applications:"):
        return app
    if not app.endswith(".desktop"):
        app += ".desktop"
    return "applications:" + app


def dock_js(d):
    """JavaScript that creates a dock panel from settings dict `d`."""
    lines = [
        "var dock = new Panel;",
        f"dock.location = {js(d.get('location', 'bottom'))};",
        f"dock.height = {int(d.get('height', 58))};",
        f"dock.alignment = {js(d.get('alignment', 'center'))};",
        f"dock.lengthMode = {js(d.get('lengthMode', 'fit'))};",
        f"dock.floating = {js(bool(d.get('floating', True)))};",
        f"dock.hiding = {js(d.get('hiding', 'dodgewindows'))};",
    ]
    if d.get("launchpad", True):
        lines += ['var lp = dock.addWidget("org.kde.plasma.kickerdash");',
                  'lp.currentConfigGroup = ["General"];',
                  'lp.writeConfig("icon", "horizon-launchpad");']
    lines += ['var t = dock.addWidget("org.kde.plasma.icontasks");',
              't.currentConfigGroup = ["General"];',
              f"t.writeConfig('launchers', {js(d.get('launchers', []))});"]
    for key in ("iconSpacing", "groupingStrategy", "showOnlyCurrentDesktop",
                "indicateAudioStreams", "highlightWindows"):
        if key in d:
            lines.append(f"t.writeConfig({js(key)}, {js(d[key])});")
    if d.get("trash", True):
        lines += ['dock.addWidget("org.kde.plasma.marginsseparator");',
                  'dock.addWidget("org.kde.plasma.trash");']
    return "\n".join(lines)


def dock_rebuild(d):
    plasma_script(JS_HELPERS + """
panels().forEach(function (p) { if (horizonIsDock(p)) p.remove(); });
""" + dock_js(d))


def topbar_js(t):
    clock = t.get("clock", {})
    lines = [
        "var top = new Panel;",
        'top.location = "top";',
        f"top.height = {int(t.get('height', 28))};",
        f"top.floating = {js(bool(t.get('floating', False)))};",
        'var menu = top.addWidget("org.kde.plasma.kickoff");',
        'menu.currentConfigGroup = ["General"];',
        'menu.writeConfig("icon", "horizon-logo-symbolic");',
    ]
    if t.get("appmenu", True):
        lines.append('top.addWidget("org.kde.plasma.appmenu");')
    lines.append('top.addWidget("org.kde.plasma.panelspacer");')
    clock_js = [
        'var clock = top.addWidget("org.kde.plasma.digitalclock");',
        'clock.currentConfigGroup = ["Appearance"];',
        f"clock.writeConfig('showDate', {js(_truthy(clock.get('showDate'), True))});",
        "clock.writeConfig('dateDisplayFormat', 'BesideTime');",
        "clock.writeConfig('dateFormat', 'custom');",
        "clock.writeConfig('customDateFormat', 'ddd d MMM');",
        f"clock.writeConfig('showSeconds', {int(clock.get('showSeconds', 0) or 0)});",
        f"clock.writeConfig('use24hFormat', {int(clock.get('use24hFormat', 1) or 0)});",
    ]
    if t.get("centerClock"):
        lines += clock_js + ['top.addWidget("org.kde.plasma.panelspacer");',
                             'top.addWidget("org.kde.plasma.systemtray");']
    else:
        lines += ['top.addWidget("org.kde.plasma.systemtray");'] + clock_js
    return "\n".join(lines)


def topbar_rebuild(t):
    plasma_script(JS_HELPERS + """
panels().forEach(function (p) { if (horizonIsTopBar(p)) p.remove(); });
""" + topbar_js(t))


def topbar_update(body):
    plasma_script(JS_HELPERS + """
panels().forEach(function (p) {
    if (!horizonIsTopBar(p)) return;
    var c = p.widgets("org.kde.plasma.digitalclock");
    %s
});
""" % body)


def clock_set(key, value):
    topbar_update(f"""if (c.length) {{ c[0].currentConfigGroup = ["Appearance"];
        c[0].writeConfig({js(key)}, {js(value)}); c[0].reloadConfig(); }}""")


def apply_layout(key):
    path = LAYOUT_DIR / f"{key}.js"
    if not path.exists():
        return False
    plasma_script("panels().forEach(function (p) { p.remove(); });\n" + path.read_text())
    kwrite("horizon-settingsrc", ["Layout"], "Current", key)
    return True


SPACING = [("Tight", 0), ("Normal", 1), ("Roomy", 2), ("Spacious", 3)]
GROUPING = [("Group windows of the same app", 1), ("Show every window separately", 0)]
ALIGNMENTS = [("Centered", "center"), ("Start", "left"), ("End", "right")]
LENGTHS = [("Fit the icons", "fit"), ("Full width", "fill")]


def installed_apps():
    """(name, icon, desktop file id) of every visible app, sorted by name."""
    apps, seen = [], set()
    for base in (os.path.expanduser("~/.local/share/applications"), "/usr/share/applications",
                 "/var/lib/flatpak/exports/share/applications"):
        folder = Path(base)
        if not folder.is_dir():
            continue
        for f in sorted(folder.glob("*.desktop")):
            if f.name in seen:
                continue
            text = f.read_text(errors="ignore")
            if "NoDisplay=true" in text or "Type=Application" not in text:
                continue
            lines = text.split("\n[", 1)[0].splitlines()
            name = next((l[5:] for l in lines if l.startswith("Name=")), f.stem)
            icon = next((l[5:] for l in lines if l.startswith("Icon=")), "")
            apps.append((name, icon, f.name))
            seen.add(f.name)
    return sorted(apps, key=lambda a: a[0].lower())


class AppPicker(QDialog):
    """Searchable list of installed apps."""

    def __init__(self, parent=None):
        super().__init__(parent)
        self.setWindowTitle("Add to dock")
        self.resize(420, 520)
        box = QVBoxLayout(self)
        self.search = QLineEdit()
        self.search.setPlaceholderText("Search apps…")
        self.search.setClearButtonEnabled(True)
        box.addWidget(self.search)
        self.list = QListWidget()
        self.list.setIconSize(QSize(28, 28))
        for name, icon, fid in installed_apps():
            item = QListWidgetItem(QIcon.fromTheme(icon, QIcon.fromTheme("application-x-executable")), name)
            item.setData(Qt.ItemDataRole.UserRole, fid)
            self.list.addItem(item)
        box.addWidget(self.list, 1)
        buttons = QDialogButtonBox(QDialogButtonBox.StandardButton.Ok | QDialogButtonBox.StandardButton.Cancel)
        buttons.accepted.connect(self.accept)
        buttons.rejected.connect(self.reject)
        box.addWidget(buttons)
        self.search.textChanged.connect(self.filter)
        self.list.itemDoubleClicked.connect(lambda _: self.accept())

    def filter(self, text):
        text = text.lower()
        for i in range(self.list.count()):
            item = self.list.item(i)
            item.setHidden(text not in item.text().lower())

    def chosen(self):
        item = self.list.currentItem()
        return item.data(Qt.ItemDataRole.UserRole) if item else None


class DockPage(Page):
    def __init__(self):
        super().__init__("Dock & Menu Bar", "Arrange your panels the way you like them.")

        layouts = self.add(Card("Desktop layout"))
        layouts.box.addWidget(muted("Replaces your current panels with a fresh preset."))
        self.layout_cards = ChoiceCards(
            [(k, name, layout_preview(k)) for k, name, _ in LAYOUTS], self.apply_layout)
        layouts.box.addWidget(self.layout_cards)
        for k, _, desc in LAYOUTS:
            self.layout_cards.buttons[k].setToolTip(desc)
        self.layout_cards.select(kread("horizon-settingsrc", ["Layout"], "Current", "macos"))

        # -------- dock: live settings
        dock = self.add(Card("Dock"))
        self.dock_note = muted("")
        dock.box.addWidget(self.dock_note)
        self.position = dock.row("Position on screen", self._combo(
            [("Bottom", "bottom"), ("Left", "left"), ("Right", "right")]))
        self.alignment = dock.row("Alignment", self._combo(ALIGNMENTS))
        self.length = dock.row("Width", self._combo(LENGTHS))
        self.size = QSlider(Qt.Orientation.Horizontal)
        self.size.setRange(36, 120)
        self.size.setMinimumWidth(220)
        self.size_label = QLabel()
        self.size_label.setMinimumWidth(48)
        wrap = QWidget()
        h = QHBoxLayout(wrap)
        h.setContentsMargins(0, 0, 0, 0)
        h.addWidget(self.size)
        h.addWidget(self.size_label)
        dock.row("Size", wrap)
        self.hiding = dock.row("Visibility", self._combo(DOCK_HIDING))
        self.floating = dock.row("Floating", QCheckBox(), "Leave a gap between the dock and the screen edge")

        # -------- dock: icons behaviour
        icons = self.add(Card("Dock icons"))
        self.spacing = icons.row("Icon spacing", self._combo(SPACING))
        self.grouping = icons.row("Windows", self._combo(GROUPING))
        self.only_desktop = icons.row("Only show apps from the current desktop", QCheckBox())
        self.audio = icons.row("Show a speaker on apps playing sound", QCheckBox())
        self.highlight = icons.row("Highlight windows when hovering an icon", QCheckBox())
        self.launchpad = icons.row("Show Launchpad", QCheckBox(), "The app grid button at the start of the dock")
        self.trash = icons.row("Show Trash", QCheckBox())

        # -------- pinned apps
        pinned = self.add(Card("Pinned apps"))
        pinned.box.addWidget(muted("Apps that always stay in the dock. You can also drag apps onto the dock."))
        self.pins = QListWidget()
        self.pins.setIconSize(QSize(28, 28))
        self.pins.setMinimumHeight(190)
        pinned.box.addWidget(self.pins)
        buttons = QHBoxLayout()
        for text, slot in (("Add app…", self.add_pin), ("Remove", self.remove_pin),
                           ("Move up", lambda: self.move_pin(-1)), ("Move down", lambda: self.move_pin(1))):
            b = QPushButton(text)
            b.clicked.connect(slot)
            buttons.addWidget(b)
        buttons.addStretch(1)
        pinned.box.addLayout(buttons)

        # -------- top bar
        top = self.add(Card("Menu bar"))
        self.top_note = muted("")
        top.box.addWidget(self.top_note)
        self.top_height = QSlider(Qt.Orientation.Horizontal)
        self.top_height.setRange(22, 44)
        self.top_height.setMinimumWidth(220)
        top.row("Height", self.top_height)
        self.top_floating = top.row("Floating", QCheckBox())
        self.appmenu = top.row("Show app menus in the bar", QCheckBox(), "File, Edit, View… like on a Mac")
        self.center_clock = top.row("Clock in the middle", QCheckBox())
        self.show_date = top.row("Show the date", QCheckBox())
        self.seconds = top.row("Show seconds", QCheckBox())
        self.clock24 = top.row("Time format", self._combo(
            [("Follow region", 1), ("24-hour", 2), ("12-hour (AM/PM)", 0)]))

        more = self.add(Card())
        btn = QPushButton("Edit panels and widgets…")
        btn.clicked.connect(lambda: dbus_call(
            "org.kde.plasmashell", "/PlasmaShell", "org.kde.PlasmaShell", "toggleWidgetExplorer"))
        more.row("Add widgets, move icons or resize panels by hand", btn)
        self.finish()

        self.state = {}
        self.reload()
        self._connect()

    @staticmethod
    def _combo(options):
        c = QComboBox()
        for label, value in options:
            c.addItem(label, value)
        return c

    def _controls(self):
        return [self.position, self.alignment, self.length, self.size, self.hiding, self.floating,
                self.spacing, self.grouping, self.only_desktop, self.audio, self.highlight,
                self.launchpad, self.trash, self.top_height, self.top_floating, self.appmenu,
                self.center_clock, self.show_date, self.seconds, self.clock24]

    def reload(self):
        self.state = panel_state()
        d = self.state.get("dock") or {}
        t = self.state.get("top") or {}
        for w in self._controls():
            w.blockSignals(True)

        def pick(combo, value, default):
            i = combo.findData(value)
            combo.setCurrentIndex(i if i >= 0 else max(0, combo.findData(default)))

        pick(self.position, d.get("location"), "bottom")
        pick(self.alignment, d.get("alignment"), "center")
        pick(self.length, d.get("lengthMode"), "fit")
        self.size.setValue(int(d.get("height", 58)))
        self.size_label.setText(f"{self.size.value()} px")
        pick(self.hiding, d.get("hiding"), "dodgewindows")
        self.floating.setChecked(d.get("floating", True))
        pick(self.spacing, d.get("iconSpacing"), 1)
        pick(self.grouping, 0 if d.get("groupingStrategy") == 0 else 1, 1)
        self.only_desktop.setChecked(d.get("showOnlyCurrentDesktop", False))
        self.audio.setChecked(d.get("indicateAudioStreams", True))
        self.highlight.setChecked(d.get("highlightWindows", True))
        self.launchpad.setChecked(d.get("launchpad", True))
        self.trash.setChecked(d.get("trash", True))
        self._fill_pins(d.get("launchers", []))

        clock = t.get("clock", {})
        self.top_height.setValue(int(t.get("height", 28) or 28))
        self.top_floating.setChecked(_truthy(t.get("floating"), False))
        self.appmenu.setChecked(t.get("appmenu", True))
        self.center_clock.setChecked(t.get("centerClock", False))
        self.show_date.setChecked(_truthy(clock.get("showDate"), True))
        self.seconds.setChecked(str(clock.get("showSeconds", 0)) not in ("0", "", "false"))
        try:
            pick(self.clock24, int(clock.get("use24hFormat", 1)), 1)
        except (TypeError, ValueError):
            pick(self.clock24, 1, 1)
        for w in self._controls():
            w.blockSignals(False)

        live = bool(self.state)
        has_dock, has_top = bool(self.state.get("dock")), bool(self.state.get("top"))
        classic = bool(d.get("classic"))
        for w in (self.position, self.alignment, self.length, self.size, self.hiding, self.floating,
                  self.spacing, self.grouping, self.only_desktop, self.audio, self.highlight, self.pins):
            w.setEnabled(has_dock or not live)
        for w in (self.launchpad, self.trash):
            w.setEnabled((has_dock and not classic) or not live)
        for w in (self.top_height, self.top_floating, self.appmenu, self.center_clock,
                  self.show_date, self.seconds, self.clock24):
            w.setEnabled(has_top or not live)
        self.dock_note.setText("" if has_dock or not live else "No dock found — pick a layout above.")
        self.dock_note.setVisible(bool(self.dock_note.text()))
        self.top_note.setText("" if has_top or not live else "No menu bar in this layout.")
        self.top_note.setVisible(bool(self.top_note.text()))

    def _connect(self):
        self.position.currentIndexChanged.connect(
            lambda: dock_update(f"p.location = {js(self.position.currentData())};"))
        self.alignment.currentIndexChanged.connect(
            lambda: dock_update(f"p.alignment = {js(self.alignment.currentData())};"))
        self.length.currentIndexChanged.connect(
            lambda: dock_update(f"p.lengthMode = {js(self.length.currentData())};"))
        self.hiding.currentIndexChanged.connect(
            lambda: dock_update(f"p.hiding = {js(self.hiding.currentData())};"))
        self.floating.toggled.connect(lambda on: dock_update(f"p.floating = {js(on)};"))
        # Debounce sliders so Plasma isn't flooded while dragging.
        self._size_timer = QTimer(self, singleShot=True, interval=250)
        self._size_timer.timeout.connect(lambda: dock_update(f"p.height = {self.size.value()};"))
        self.size.valueChanged.connect(lambda v: (self.size_label.setText(f"{v} px"), self._size_timer.start()))
        self.spacing.currentIndexChanged.connect(
            lambda: dock_set_task_option("iconSpacing", self.spacing.currentData()))
        self.grouping.currentIndexChanged.connect(
            lambda: dock_set_task_option("groupingStrategy", self.grouping.currentData()))
        self.only_desktop.toggled.connect(lambda on: dock_set_task_option("showOnlyCurrentDesktop", on))
        self.audio.toggled.connect(lambda on: dock_set_task_option("indicateAudioStreams", on))
        self.highlight.toggled.connect(lambda on: dock_set_task_option("highlightWindows", on))
        self.launchpad.toggled.connect(lambda _: self.rebuild_dock())
        self.trash.toggled.connect(lambda _: self.rebuild_dock())

        self._top_timer = QTimer(self, singleShot=True, interval=250)
        self._top_timer.timeout.connect(lambda: topbar_update(f"p.height = {self.top_height.value()};"))
        self.top_height.valueChanged.connect(lambda: self._top_timer.start())
        self.top_floating.toggled.connect(lambda on: topbar_update(f"p.floating = {js(on)};"))
        self.appmenu.toggled.connect(lambda _: self.rebuild_top())
        self.center_clock.toggled.connect(lambda _: self.rebuild_top())
        self.show_date.toggled.connect(lambda on: clock_set("showDate", on))
        self.seconds.toggled.connect(lambda on: clock_set("showSeconds", 2 if on else 0))
        self.clock24.currentIndexChanged.connect(lambda: clock_set("use24hFormat", self.clock24.currentData()))

    # ---- pinned apps
    def _fill_pins(self, launchers):
        self.pins.clear()
        for entry in launchers:
            desktop_id = entry.split(":", 1)[-1]
            name, icon = desktop_id, "application-x-executable"
            for base in ("/usr/share/applications", os.path.expanduser("~/.local/share/applications"),
                         "/var/lib/flatpak/exports/share/applications"):
                f = Path(base) / desktop_id
                if f.exists():
                    for line in f.read_text(errors="ignore").splitlines():
                        if line.startswith("Name=") and name == desktop_id:
                            name = line[5:]
                        elif line.startswith("Icon="):
                            icon = line[5:]
                        elif line.startswith("[") and line != "[Desktop Entry]":
                            break
                    break
            item = QListWidgetItem(QIcon.fromTheme(icon), name)
            item.setData(Qt.ItemDataRole.UserRole, entry)
            self.pins.addItem(item)

    def _pins(self):
        return [self.pins.item(i).data(Qt.ItemDataRole.UserRole) for i in range(self.pins.count())]

    def _save_pins(self):
        dock_set_launchers(self._pins())

    def add_pin(self):
        picker = AppPicker(self)
        if picker.exec() == QDialog.DialogCode.Accepted and picker.chosen():
            entry = normalize_app(picker.chosen())
            if entry not in self._pins():
                self._fill_pins(self._pins() + [entry])
                self._save_pins()

    def remove_pin(self):
        row = self.pins.currentRow()
        if row >= 0:
            self.pins.takeItem(row)
            self._save_pins()

    def move_pin(self, delta):
        row = self.pins.currentRow()
        new = row + delta
        if row < 0 or not 0 <= new < self.pins.count():
            return
        item = self.pins.takeItem(row)
        self.pins.insertItem(new, item)
        self.pins.setCurrentRow(new)
        self._save_pins()

    # ---- rebuilds
    def _dock_settings(self):
        d = dict(self.state.get("dock") or {})
        d.update(location=self.position.currentData(), alignment=self.alignment.currentData(),
                 lengthMode=self.length.currentData(), height=self.size.value(),
                 hiding=self.hiding.currentData(), floating=self.floating.isChecked(),
                 iconSpacing=self.spacing.currentData(), groupingStrategy=self.grouping.currentData(),
                 showOnlyCurrentDesktop=self.only_desktop.isChecked(),
                 indicateAudioStreams=self.audio.isChecked(), highlightWindows=self.highlight.isChecked(),
                 launchpad=self.launchpad.isChecked(), trash=self.trash.isChecked(), launchers=self._pins())
        return d

    def rebuild_dock(self):
        dock_rebuild(self._dock_settings())
        QTimer.singleShot(800, self.reload)

    def rebuild_top(self):
        topbar_rebuild({
            "height": self.top_height.value(), "floating": self.top_floating.isChecked(),
            "appmenu": self.appmenu.isChecked(), "centerClock": self.center_clock.isChecked(),
            "clock": {"showDate": self.show_date.isChecked(), "showSeconds": 2 if self.seconds.isChecked() else 0,
                      "use24hFormat": self.clock24.currentData()},
        })
        QTimer.singleShot(800, self.reload)

    def apply_layout(self, key):
        answer = QMessageBox.question(
            self, APP_NAME, "Switch layout? Your current panels and their widgets will be replaced.")
        if answer != QMessageBox.StandardButton.Yes:
            self.layout_cards.select(kread("horizon-settingsrc", ["Layout"], "Current", "macos"))
            return
        if not apply_layout(key):
            QMessageBox.warning(self, APP_NAME, f"Layout file for '{key}' is missing.")
            return
        QTimer.singleShot(1200, self.reload)


class WindowsPage(Page):
    def __init__(self):
        super().__init__("Windows & Animations", "Tune how windows look, move and feel.")

        buttons = self.add(Card("Title bar buttons"))
        self.buttons = ChoiceCards(
            [("left", "Left (macOS)", titlebar_preview("left")),
             ("right", "Right (Windows)", titlebar_preview("right"))],
            self.set_buttons, QSize(150, 40))
        buttons.box.addWidget(self.buttons)
        left = kread("kwinrc", ["org.kde.kdecoration2"], "ButtonsOnLeft", "XIA") or ""
        self.buttons.select("left" if "X" in left else "right")

        anim = self.add(Card("Animations"))
        self.speed = QSlider(Qt.Orientation.Horizontal)
        self.speed.setRange(0, len(ANIMATION_SPEEDS) - 1)
        self.speed.setMinimumWidth(220)
        self.speed.setTickPosition(QSlider.TickPosition.TicksBelow)
        self.speed_label = QLabel()
        self.speed_label.setMinimumWidth(70)
        factor = float(kread("kdeglobals", ["KDE"], "AnimationDurationFactor", "0.85") or 0.85)
        idx = min(range(len(ANIMATION_SPEEDS)), key=lambda i: abs(ANIMATION_SPEEDS[i][1] - factor))
        self.speed.setValue(idx)
        self.speed_label.setText(ANIMATION_SPEEDS[idx][0])
        self.speed.valueChanged.connect(self.set_speed)
        wrap = QWidget()
        h = QHBoxLayout(wrap)
        h.setContentsMargins(0, 0, 0, 0)
        h.addWidget(self.speed)
        h.addWidget(self.speed_label)
        anim.row("Animation speed", wrap)

        self.minimize = QComboBox()
        for label, eff in MINIMIZE_EFFECTS:
            self.minimize.addItem(label, eff)
        self.minimize.setCurrentIndex(self._current_effect(MINIMIZE_EFFECTS))
        self.minimize.currentIndexChanged.connect(
            lambda: self.set_exclusive(MINIMIZE_EFFECTS, self.minimize.currentData()))
        anim.row("Minimise effect", self.minimize)

        self.opening = QComboBox()
        for label, eff in OPEN_EFFECTS:
            self.opening.addItem(label, eff)
        self.opening.setCurrentIndex(self._current_effect(OPEN_EFFECTS))
        self.opening.currentIndexChanged.connect(
            lambda: self.set_exclusive(OPEN_EFFECTS, self.opening.currentData()))
        anim.row("Open & close effect", self.opening)

        fx = self.add(Card("Effects"))
        for name, label, hint, default in [
            ("blur", "Translucent blur", "Frosted-glass look for panels and menus", True),
            ("wobblywindows", "Wobbly windows", "Windows bend like jelly while you drag them", False),
            ("slide", "Slide between desktops", "Animate switching virtual desktops", True),
            ("dimscreen", "Dim screen for admin prompts", "Focus attention on password dialogs", False),
        ]:
            box = QCheckBox()
            box.setChecked(self._enabled(name, default))
            box.toggled.connect(lambda on, n=name: self.toggle(n, on))
            fx.row(label, box, hint)
        self.finish()

    @staticmethod
    def _enabled(name, default):
        return (kread("kwinrc", ["Plugins"], f"{name}Enabled", str(default).lower()) or "").lower() == "true"

    def _current_effect(self, options):
        defaults = {"magiclamp": True, "scale": True}
        for i, (_, eff) in enumerate(options):
            if eff and self._enabled(eff, defaults.get(eff, False)):
                return i
        return len(options) - 1

    def set_exclusive(self, options, chosen):
        set_exclusive_effect(options, chosen)

    def toggle(self, name, on):
        toggle_effect(name, on)

    def set_buttons(self, side):
        set_title_buttons(side)

    def set_speed(self, idx):
        label, factor = ANIMATION_SPEEDS[idx]
        self.speed_label.setText(label)
        set_animation_speed(factor)


def read_file(path, default=""):
    try:
        return Path(path).read_text(errors="ignore").strip()
    except OSError:
        return default


def secure_boot_state():
    if not os.path.isdir("/sys/firmware/efi"):
        return "Not available (legacy BIOS)"
    for f in glob.glob("/sys/firmware/efi/efivars/SecureBoot-*"):
        try:
            return "On" if Path(f).read_bytes()[-1] == 1 else "Off"
        except OSError:
            pass
    return "Unknown"


def grub_setting(key, default=""):
    value = default
    for f in ["/etc/default/grub"] + sorted(glob.glob("/etc/default/grub.d/*.cfg")):
        for line in read_file(f).splitlines():
            if line.startswith(key + "="):
                value = line.split("=", 1)[1].strip().strip('"')
    return value


def uefi_entries():
    """[(number, label, active, current)] from efibootmgr."""
    res = run("efibootmgr")
    if not res or res.returncode != 0:
        return []
    current = ""
    entries = []
    for line in res.stdout.splitlines():
        if line.startswith("BootCurrent:"):
            current = line.split(":", 1)[1].strip()
        m = re.match(r"Boot([0-9A-Fa-f]{4})(\*?)\s+(.*)", line)
        if m:
            label = re.split(r"\t|\s{2,}|HD\(|PciRoot\(|VenHw\(|BBS\(", m.group(3))[0].strip()
            entries.append((m.group(1), label, bool(m.group(2)), m.group(1) == current))
    return entries


def in_terminal(command):
    """Run a horizon command in Konsole and keep the window open."""
    subprocess.Popen(["konsole", "--hold", "-e", "bash", "-c", command])


class BootPage(Page):
    def __init__(self):
        super().__init__("Boot & UEFI", "Firmware, Secure Boot, the boot menu and system maintenance.")
        efi = os.path.isdir("/sys/firmware/efi")

        info = self.add(Card("This computer"))
        vendor = read_file("/sys/class/dmi/id/bios_vendor")
        version = read_file("/sys/class/dmi/id/bios_version")
        date = read_file("/sys/class/dmi/id/bios_date")
        esp = ""
        res = run("findmnt", "-no", "SOURCE,SIZE,AVAIL", "/boot/efi")
        if res and res.stdout.strip():
            src, size, avail = (res.stdout.split() + ["", "", ""])[:3]
            esp = f"{src} — {avail} free of {size}"
        for label, value in [("Boot mode", "UEFI" if efi else "Legacy BIOS"),
                             ("Secure Boot", secure_boot_state()),
                             ("Firmware", " ".join(p for p in (vendor, version) if p)),
                             ("Firmware date", date), ("EFI partition", esp)]:
            if value:
                v = QLabel(value)
                v.setTextInteractionFlags(Qt.TextInteractionFlag.TextSelectableByMouse)
                info.row(label, v)

        uefi = self.add(Card("UEFI"))
        fw = QPushButton("Restart into firmware settings…")
        fw.setEnabled(efi)
        fw.clicked.connect(self.firmware_setup)
        uefi.row("Change boot order, Secure Boot, virtualization and other firmware options", fw)
        upd = QPushButton("Check for firmware updates")
        upd.clicked.connect(lambda: subprocess.Popen(["plasma-discover", "--mode", "update"]))
        uefi.row("UEFI, SSD and device firmware from the vendor (via fwupd)", upd)
        if efi:
            self.entries = QListWidget()
            self.entries.setMinimumHeight(120)
            for num, label, active, current in uefi_entries():
                text = f"{num}  {label}" + ("   (running now)" if current else "") + ("" if active else "   (disabled)")
                item = QListWidgetItem(QIcon.fromTheme("drive-harddisk"), text)
                item.setData(Qt.ItemDataRole.UserRole, num)
                self.entries.addItem(item)
            uefi.box.addWidget(QLabel("Boot entries"))
            uefi.box.addWidget(self.entries)
            once = QPushButton("Start the selected entry once on next restart")
            once.clicked.connect(self.boot_once)
            uefi.box.addWidget(once, 0, Qt.AlignmentFlag.AlignLeft)

        menu = self.add(Card("Boot menu"))
        installed = Path("/etc/default/grub").exists() and not is_live_session()
        if not installed:
            menu.box.addWidget(muted("Available after installing to disk."))
        self.show_menu = menu.row("Show the boot menu at startup", QCheckBox(),
                                  "Otherwise hold Shift (BIOS) or press Esc (UEFI) while starting")
        self.show_menu.setChecked(grub_setting("GRUB_TIMEOUT_STYLE", "menu") == "menu")
        self.timeout = QSpinBox()
        self.timeout.setRange(1, 30)
        self.timeout.setSuffix(" s")
        try:
            self.timeout.setValue(int(grub_setting("GRUB_TIMEOUT", "3") or 3))
        except ValueError:
            self.timeout.setValue(3)
        menu.row("Wait before starting", self.timeout)
        self.themed = menu.row("Graphical boot menu", QCheckBox())
        self.themed.setChecked(bool(grub_setting("GRUB_THEME")))
        apply_btn = QPushButton("Apply…")
        apply_btn.clicked.connect(self.apply_boot_menu)
        menu.row("Needs your password", apply_btn)
        for w in (self.show_menu, self.timeout, self.themed, apply_btn):
            w.setEnabled(installed)

        care = self.add(Card("Maintenance"))
        for label, hint, command in [
            ("Update everything", "System packages, Flatpak apps and firmware", "horizon update"),
            ("Health check", "Disk space, services, drivers, firewall, backups", "horizon doctor"),
            ("Recommended drivers", "Graphics and Wi-Fi drivers for this computer", "horizon drivers list"),
            ("Free up space", "Old packages, caches and logs", "horizon clean"),
        ]:
            b = QPushButton(label)
            b.clicked.connect(lambda _=False, c=command: in_terminal(c))
            care.row(hint, b)
        self.finish()

    def firmware_setup(self):
        if QMessageBox.question(self, APP_NAME, "Restart now into the UEFI firmware settings?\n"
                                "Save your work first.") == QMessageBox.StandardButton.Yes:
            run("systemctl", "reboot", "--firmware-setup")

    def boot_once(self):
        item = self.entries.currentItem()
        if item:
            num = item.data(Qt.ItemDataRole.UserRole)
            res = run("pkexec", "horizon", "-y", "uefi", "next", num)
            if res and res.returncode == 0:
                QMessageBox.information(self, APP_NAME, f"Entry {num} will start once on the next restart.")

    def apply_boot_menu(self):
        res = run("pkexec", "horizon", "-y", "boot", "set",
                  f"menu={'on' if self.show_menu.isChecked() else 'off'}",
                  f"timeout={self.timeout.value()}",
                  f"theme={'on' if self.themed.isChecked() else 'off'}")
        if res and res.returncode == 0:
            QMessageBox.information(self, APP_NAME, "Boot menu updated.")
        elif res:
            QMessageBox.warning(self, APP_NAME, "Could not update the boot menu.\n\n" + (res.stderr or res.stdout)[-600:])


class AboutPage(Page):
    def __init__(self):
        info = os_release()
        super().__init__("About this computer")
        top = QHBoxLayout()
        logo = QLabel()
        logo.setPixmap(QIcon.fromTheme("horizon-logo").pixmap(112, 112))
        top.addWidget(logo)
        text = QVBoxLayout()
        text.addWidget(heading(info.get("NAME", DISTRO_NAME), 30))
        text.addWidget(muted(f"Version {info.get('VERSION', '')}"))
        text.addStretch(1)
        top.addLayout(text, 1)
        self.box.addLayout(top)

        card = self.add(Card())
        uname = os.uname()
        mem = ""
        try:
            kb = int(next(l for l in open("/proc/meminfo") if l.startswith("MemTotal")).split()[1])
            mem = f"{kb / 1024 / 1024:.1f} GB"
        except (OSError, StopIteration, ValueError):
            pass
        cpu = ""
        try:
            cpu = next(l for l in open("/proc/cpuinfo") if l.startswith("model name")).split(":", 1)[1].strip()
        except (OSError, StopIteration):
            pass
        plasma = run("plasmashell", "--version")
        rows = [
            ("Based on", f"Ubuntu {info.get('UBUNTU_CODENAME', '').capitalize()}"),
            ("Desktop", plasma.stdout.strip().replace("plasmashell", "KDE Plasma") if plasma and plasma.stdout else "KDE Plasma"),
            ("Kernel", uname.release),
            ("Processor", cpu),
            ("Memory", mem),
            ("Computer name", uname.nodename),
        ]
        for k, v in rows:
            if v:
                label = QLabel(v)
                label.setTextInteractionFlags(Qt.TextInteractionFlag.TextSelectableByMouse)
                card.row(k, label)

        more = self.add(Card())
        adv = QPushButton("Open System Settings…")
        adv.clicked.connect(lambda: subprocess.Popen(["systemsettings"]))
        more.row("Every other option (displays, network, users, power…)", adv)
        info_btn = QPushButton("Detailed system report…")
        info_btn.clicked.connect(lambda: subprocess.Popen(["kinfocenter"]))
        more.row("Hardware and driver details", info_btn)
        self.finish()


