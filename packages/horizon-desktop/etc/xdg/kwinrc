# Window manager defaults: macOS-style title bar buttons (left: close, minimise,
# maximise) and smooth animations. Change these live in "Horizon Settings".
[org.kde.kdecoration2]
library=org.kde.kwin.aurorae
theme=__aurorae__svg__WhiteSur
ButtonsOnLeft=XIA
ButtonsOnRight=
BorderSize=None
BorderSizeAuto=false

[Plugins]
magiclampEnabled=true
squashEnabled=false
blurEnabled=true
contrastEnabled=true
wobblywindowsEnabled=false
scaleEnabled=true
slideEnabled=true
overviewEnabled=true

[Effect-magiclamp]
AnimationDuration=320

[Effect-blur]
BlurStrength=10
NoiseStrength=3

[Effect-slide]
HorizontalGap=0
VerticalGap=0
SlideBackground=false

[Desktops]
Number=4
Rows=1

[TabBox]
LayoutName=big_icons
HighlightWindows=false

[Windows]
FocusStealingPreventionLevel=1
